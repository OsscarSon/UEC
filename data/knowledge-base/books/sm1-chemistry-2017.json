  "entries": [
    {
      "id": "kb-chem3-dalton",
      "bookId": "sm1-chemistry-2017",
      "lessonKey": "化学3",
      "chapter": 3,
      "section": "3.1",
      "type": "definition",
      "title": "道尔顿原子学说（四项基本观点与历史局限）",
      "page": "p.43",
      "summary": "道尔顿于1803–1808年提出原子学说，将微观原子假设与宏观定比、倍比、物质不灭三大定量定律统一起来。",
      "points": [
        "观点一：物质由不可再分的微小粒子——原子组成（现代修正：原子核由质子、中子组成，核外有电子，仍可在化学反应中保持完整性）。",
        "观点二：同一元素的所有原子质量、大小及性质完全相同；不同元素的原子质量和性质不同（现代修正：同位素质量数不同，平均相对原子质量由丰度加权）。",
        "观点三：化合物由不同元素的原子按简单整数比结合而成（但大分子、非整比晶体除外）。",
        "观点四：化学反应只是原子的重新组合，反应中原子既不能被消灭，也不能被创造，数量与种类不变。"
      ],
      "tags": ["原子学说", "道尔顿", "化学变化本质"]
    },
    {
      "id": "kb-chem3-avogadro",
      "bookId": "sm1-chemistry-2017",
      "lessonKey": "化学3",
      "chapter": 3,
      "section": "3.1",
      "type": "law",
      "title": "阿伏加德罗分子学说与教材 Hb/CO 中毒实例",
      "page": "p.44–45",
      "summary": "1811年阿伏加德罗提出分子概念，解决道尔顿原子学说与盖·吕萨克气体体积整数比定律之间的矛盾，并提出分子是保持物质化学性质的最小微粒。",
      "tex": "\\mathrm{Hb} + \\mathrm{O_2} \\longrightarrow \\mathrm{HbO_2},\\qquad \\mathrm{Hb} + \\mathrm{CO} \\longrightarrow \\mathrm{HbCO}",
      "points": [
        "分子定义：分子是保持物质化学性质的最小微粒；同种物质分子性质相同，不同种物质分子性质不同。",
        "分子动理论两点补充：分子处在不断运动状态中（扩散现象，如氯化氢与氨气生成氯化铵白烟），且分子间存在一定间隔（液体混合总体积小于之和）。",
        "教材实例（p.44）：氧气分子与一氧化碳分子结构不同导致化学性质迥异——血红蛋白（Hb）与 CO 的结合能力远强于 O₂，使 Hb 失去携氧能力导致煤气中毒。"
      ],
      "tags": ["分子学说", "阿伏加德罗", "双原子分子", "CO中毒"]
    },
    {
      "id": "kb-chem3-conservation",
      "bookId": "sm1-chemistry-2017",
      "lessonKey": "化学3",
      "chapter": 3,
      "section": "3.2",
      "type": "law",
      "title": "物质不灭定律（质量守恒定律）",
      "page": "p.45–47",
      "summary": "参加化学反应的各物质的质量总和，等于反应后生成的各物质的质量总和；其微观实质是化学反应前后原子的种类、数目与质量均不增减。",
      "tex": "\\sum m_{\\text{参加反应的反应物}} = \\sum m_{\\text{生成的产物}}",
      "points": [
        "拉瓦锡（1774年）：通过密闭曲颈甑重做锡的煅烧实验确立该定律。",
        "严格前提：仅指‘化学变化’，且必须计入所有参与反应的气体及生成的气体，未参加反应的过量物质不计入‘参加反应的反应物’。",
        "六个不变：宏观反应前后总质量不变、元素种类不变、各元素总质量不变；微观原子种类不变、原子数目不变、原子质量不变。分子总数和气体体积则可能改变。"
      ],
      "tags": ["物质不灭定律", "质量守恒定律", "拉瓦锡", "六个不变"]
    },
    {
      "id": "kb-chem3-exp1",
      "bookId": "sm1-chemistry-2017",
      "lessonKey": "化学3",
      "chapter": 3,
      "section": "3.2",
      "type": "experiment",
      "title": "活动探究1：验证物质不灭定律（白磷密闭燃烧 & BaCl₂ + H₂SO₄）",
      "page": "p.46–47",
      "summary": "教材通过密闭锥形瓶白磷燃烧与溶液沉淀反应对比，演示封闭体系中天平前后完全平衡。",
      "tex": "\\mathrm{P_4(s) + 5O_2(g)} \\xrightarrow{\\text{点燃}} \\mathrm{2P_2O_5(s)},\\qquad \\mathrm{BaCl_2(aq) + H_2SO_4(aq) \\longrightarrow BaSO_4(s) + 2HCl(aq)}",
      "points": [
        "活动1（白磷燃烧）：锥形瓶底部铺干燥细沙（防止炸裂瓶底），塞紧橡皮塞（防止五氧化二磷白烟逸出或空气进出），冷却至室温后再称量（避免热空气浮力造成示数偏小）。",
        "活动2（BaCl₂ + 稀H₂SO₄）：无色溶液混合后产生白色 BaSO₄ 沉淀，因无气体逸出，天平保持平衡。",
        "考场实验探究高频考点：若敞口烧杯中进行 Mg 燃烧或碳酸盐与酸反应，因吸收空气中的 O₂（增重）或逸出 MgO 白烟/CO₂ 气体（减重），天平看似失衡，但体系本身仍遵守物质不灭定律。"
      ],
      "tags": ["活动探究1", "白磷燃烧", "沉淀反应", "敞口误差分析"]
    },
    {
      "id": "kb-chem3-definite",
      "bookId": "sm1-chemistry-2017",
      "lessonKey": "化学3",
      "chapter": 3,
      "section": "3.2",
      "type": "law",
      "title": "定比定律（定组成定律）",
      "page": "p.48–49",
      "summary": "任何纯净的化合物都有固定的组成，无论该化合物从何处获取、用何种方法制得，其各组成元素的质量比恒定。",
      "tex": "\\frac{m_{\\text{元素A}}}{m_{\\text{元素B}}} = \\frac{x\\,A_r(\\mathrm{A})}{y\\,A_r(\\mathrm{B})} = \\text{常数}",
      "points": [
        "教材例证：无论海水、河水、井水还是雨水，经纯化电解后得到的氢气与氧气质量比恒为 1 : 8。",
        "微观解释：在每一种化合物分子或化学式中，组成它的每种元素的原子数目之比固定，而每种元素的平均原子质量也一定，因此宏观质量比恒定。",
        "应用：可用来检验样品是否为纯净物，或根据实验测得的金属氧化物质量比例求部分样品可还原出的金属质量（教材例2，p.49）。"
      ],
      "tags": ["定比定律", "定组成定律", "纯度判断"]
    },

  "29.4": {
    "content_batch": "batch06",
    "subject": "数学",
    "subject_code": "math_shared",
    "chapter_id": 29,
    "section_id": "29.4",
    "goals": [
      "由根式类型选择三角代换并写完整微分",
      "在指定角区间处理绝对值并换回原变量"
    ],
    "prerequisites": [
      "三角恒等式",
      "根式、反三角与换元"
    ],
    "flow": [
      "根式识别",
      "角域选支",
      "完整微分",
      "三角积分",
      "回代验域"
    ],
    "concept_relation": "根式识别；角域选支；完整微分；三角积分；回代验域",
    "deep": [
      "积分结束要用代换关系回到x。可用辅助直角三角形表达三角比，但边长应非负，x可能为负时需靠角区间和代数符号另外判断，不能画一个负长度三角形混过去。反三角函数的选支正是保证回代一致的工具。",
      "对√(x²−a²)，正分支x>a可取0<θ<π/2的sec代换；负分支需另选区间和符号。只完成一个分支的推导不能不说明就把结论视为全域单一公式。最终含ln绝对值的表达式可在多个区间成立，但仍应通过求导和分支核验来确认。",
      "并非出现根式就一定用三角代换。若分子恰是根内导数，普通u代换更直接；完成平方后也可能匹配基本反三角表。定积分还要同步变端点并检查端点奇性，三角代换简化形式不自动证明所有广义积分收敛。"
    ],
    "derive": [
      "a>0：a²−x²常用x=a sinθ；a²+x²常用x=a tanθ；x²−a²按分支用x=a secθ。",
      "√(cos²θ)=|cosθ|，仅在所选cosθ≥0区间可写cosθ。",
      "全部x、dx及定积分端点同时转换，最后按同一分支换回。"
    ],
    "examples": [
      {
        "q": "求∫dx/√(25−x²)。 条件：−5<x<5。",
        "given": "−5<x<5。",
        "analysis": "圆形差平方。",
        "method": "x=5sinθ，−π/2<θ<π/2。",
        "principle": "三角换元。",
        "steps": [
          "dx=5cosθ dθ，根式=5cosθ。",
          "积分=∫dθ=θ+C。"
        ],
        "ans": "arcsin(x/5)+C。",
        "verification": "导数(1/5)/√(1−x²/25)=1/√(25−x²)。",
        "pitfall": "省角域后无条件去绝对值。",
        "question_origin": "original",
        "paper_no": null,
        "subject_code": "math_shared",
        "chapter_id": 29,
        "primary_section": "29.4",
        "related_sections": []
      },
      {
        "q": "求∫√(16−x²)dx。 条件：−4<x<4。",
        "given": "−4<x<4。",
        "analysis": "sin代换后降幂。",
        "method": "x=4sinθ。",
        "principle": "换元与cos²降幂。",
        "steps": [
          "dx=4cosθ dθ，积分=16∫cos²θ dθ=8θ+4sin2θ+C。",
          "回代sin2θ=x√(16−x²)/8。"
        ],
        "ans": "x√(16−x²)/2+8arcsin(x/4)+C。",
        "verification": "求导后根式项合为√(16−x²)。",
        "pitfall": "漏dx导致只有4而非16。",
        "question_origin": "original",
        "paper_no": null,
        "subject_code": "math_shared",
        "chapter_id": 29,
        "primary_section": "29.4",
        "related_sections": []
      },
      {
        "q": "求∫dx/√(x²−9)。 条件：限定x>3。",
        "given": "限定x>3。",
        "analysis": "sec代换对应差平方正分支。",
        "method": "x=3secθ，0<θ<π/2。",
        "principle": "sec²−1=tan²。",
        "steps": [
          "根式3tanθ，dx=3secθ tanθ dθ，故积分∫secθ dθ。",
          "得ln(secθ+tanθ)+C，回代并吸收ln3。"
        ],
        "ans": "ln(x+√(x²−9))+C，x>3。",
        "verification": "导数=1/√(x²−9)，所列对数真数正。",
        "pitfall": "将正支推导直接当负支不加检查。",
        "question_origin": "original",
        "paper_no": null,

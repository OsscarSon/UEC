        "method": "积分因子e^(2x)。",
        "principle": "乘积求导。",
        "steps": [
          "(e^(2x)y)′=6e^(2x)，积分得e^(2x)y=3e^(2x)+C。",
          "y=3+Ce^(−2x)，初值给C=−2。"
        ],
        "ans": "y=3−2e^(−2x)。",
        "verification": "y′=4e^(−2x)，加2y恰6，初值1。",
        "pitfall": "μ只乘部分项。",
        "question_origin": "original",

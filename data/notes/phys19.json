  "19.4": {
    "content_batch": "batch06",
    "subject": "物理",
    "subject_code": "physics",
    "chapter_id": 19,
    "section_id": "19.4",
    "goals": [
      "用物像距或位移法测焦距并推导条件",
      "设计清晰成像、重复与误差评估"
    ],
    "prerequisites": [
      "薄透镜公式",
      "测量误差和配对数据"
    ],
    "flow": [
      "共轴装置",
      "清晰实像",
      "配对距离",
      "位移推导",
      "误差与方法"
    ],
    "concept_relation": "共轴装置；清晰实像；配对距离；位移推导；误差与方法",
    "deep": [
      "位移法固定物屏距离D，若D>4f，可有两个清晰成像镜位，物距像距互换。两镜位间距d=|u−v|，且u+v=D、uv=fD，故D²−d²=4uv=4fD，得f=(D²−d²)/(4D)。D=4f时两位置重合，D<4f时没有这两个实像位置。",
      "实验误差包括屏面倾斜、透镜偏轴、像差、厚透镜近似、位置读数及清晰像判断。应说明改善如何对应误差，例如小孔限制近轴范围可能减像差但也降低亮度；不可用“多测几次”代替所有系统误差修正，也不能在无不确定度模型时宣布精确到任意多位。",
      "发散透镜对普通实物形成虚像，单独用屏在像侧移动找清晰实像一般不能测其负焦距。可用辅助会聚系统等适当方法，但须交代有效物像和符号，不直接把凸镜操作照搬。报告应注明所测镜型、方法、原始配对数据、合理精度及模型限制。"
    ],
    "derive": [
      "共轭法f=uv/(u+v)，每组u、v须来自同次清晰成像。",
      "位移法D=u+v、d=|u−v|⇒f=(D²−d²)/(4D)，双实像位置需D>4f。",
      "远物法v≈f需u≫f；凹透镜对普通实物不可单独屏接虚像。"
    ],

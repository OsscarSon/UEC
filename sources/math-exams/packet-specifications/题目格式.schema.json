{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEC generated question",
  "type": "object",
  "required": [
    "id",
    "exam_type",
    "section",
    "number",
    "marks",
    "primary_chapter",
    "difficulty",
    "stem_latex",
    "answer",
    "solution_steps",
    "marking_points",
    "verification_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "exam_type": {
      "enum": [
        "semester_final",
        "preexam_math_ii"
      ]
    },
    "section": {
      "enum": [
        "mcq",
        "written"
      ]
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "marks": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "primary_chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 35
    },
    "secondary_chapters": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 35
      },
      "uniqueItems": true
    },
    "subchapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "difficulty": {
      "enum": [
        "basic",
        "medium",
        "hard"
      ]
    },
    "stem_latex": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        },
        "D": {
          "type": "string"
        }
      },
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "solution_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "marking_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "marks"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "marks": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "verification_status": {
      "enum": [
        "verified",
        "needs_review",
        "failed"
      ]
    },
    "source_inspiration": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_origin": {
      "const": "original_generated"
    }
  }
}
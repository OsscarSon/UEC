rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/state/current {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['version','revision','payload','updatedAt'])
    && request.resource.data.version == 1
    && request.resource.data.payload is string
    && request.resource.data.payload.size() <= 700000
    && request.resource.data.revision is int
    && request.resource.data.updatedAt == request.time
    && ((!exists(/databases/$(database)/documents/users/$(uid)/state/current) && request.resource.data.revision == 1)
     || (exists(/databases/$(database)/documents/users/$(uid)/state/current) && request.resource.data.revision == resource.data.revision + 1));
   allow delete: if false;
  }
 }
}
